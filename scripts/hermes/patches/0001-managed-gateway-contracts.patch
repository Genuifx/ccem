new file mode 100644
index 0000000..052ec1a
--- /dev/null
+++ b/plugins/platforms/wecom/strict_delivery.py
@@ -0,0 +1,83 @@
+"""One uniquely correlated WeCom DM request on the existing socket; no retries."""
+
+from __future__ import annotations
+
+import asyncio
+
+from gateway.managed_contracts import strict_result
+
+
+async def send_strict(adapter, chat_id: str, content: str, *, thread_id=None):
+    if not isinstance(chat_id, str) or not chat_id or chat_id != chat_id.strip():
+        return strict_result("not_sent", "invalid_chat_id")
+    if thread_id is not None:
+        return strict_result("not_sent", "thread_unsupported")
+    if chat_id in adapter._group_chat_ids:
+        return strict_result("not_sent", "strict_group_unsupported")
+    if not isinstance(content, str) or not content.strip():
+        return strict_result("not_sent", "invalid_text")
+    try:
+        byte_length = len(content.encode("utf-8"))
+    except UnicodeError:
+        return strict_result("not_sent", "invalid_text")
+    # The legacy helper truncates by characters. A strict request is one complete
+    # payload, conservatively bounded by UTF-8 bytes before that helper is used.
+    if byte_length > adapter.MAX_MESSAGE_LENGTH:
+        return strict_result("not_sent", "text_too_long")
+    if not adapter.is_connected or not adapter._ws or adapter._ws.closed:
+        return strict_result("not_sent", "live_adapter_unavailable")
+
+    cancelled = False
+
+    async def attempt():
+        if cancelled:
+            return strict_result("not_sent", "cancelled_before_send")
+        return await _attempt(adapter, chat_id, content)
+
+    try:
+        return await adapter._enqueue_chat_send(chat_id, attempt)
+    except asyncio.CancelledError:
+        # A queued request must not start after its caller gives up. If already
+        # sending, the queue owns that one attempt and the caller records unknown.
+        cancelled = True
+        raise
+
+
+async def _attempt(adapter, chat_id, content):
+    from plugins.platforms.wecom.adapter import APP_CMD_SEND, REQUEST_TIMEOUT_SECONDS
+
+    # Passive replies reuse inbound req_id (also used by stream/control replies).
+    # A late ACK could confirm a different send. Strict DM delivery selects the
+    # proactive path BEFORE attempting any send and mints one correlation ID.
+    # Groups require passive replies and do not yet have this strict capability.
+    if chat_id in adapter._group_chat_ids:
+        return strict_result("not_sent", "strict_group_unsupported")
+    req_id = adapter._new_req_id(APP_CMD_SEND)
+    body = {"chatid": chat_id, **adapter._markdown_body(content)}
+    try:
+        response = await adapter._request(APP_CMD_SEND, req_id, body, REQUEST_TIMEOUT_SECONDS)
+    except asyncio.CancelledError:
+        raise
+    except asyncio.TimeoutError:
+        return strict_result("unknown", "ack_timeout")
+    except Exception:
+        return strict_result("unknown", "transport_exception")
+    # Missing errcode is not an ACK. A req_id is a request receipt, not a
+    # fabricated message identifier; only an explicitly returned msgid is one.
+    if not isinstance(response, dict) or adapter._payload_req_id(response) != req_id:
+        return strict_result("unknown", "invalid_ack")
+    code = response.get("errcode")
+    if isinstance(code, bool) or not isinstance(code, int):
+        return strict_result("unknown", "invalid_ack")
+    if code != 0:
+        return strict_result("not_sent", "platform_rejected", receipt_id=req_id)
+    response_body = response.get("body")
+    response_body = response_body if isinstance(response_body, dict) else {}
+    actual_chat = response_body.get("chatid", chat_id)
+    if actual_chat != chat_id:
+        return strict_result("unknown", "target_mismatch", receipt_id=req_id)
+    message_id = response_body.get("msgid")
+    return strict_result(
+        "sent", target={"chat_id": chat_id, "thread_id": None},
+        message_id=str(message_id) if message_id else None, receipt_id=req_id,
+    )
