diff --git a/gateway/managed_contracts.py b/gateway/managed_contracts.py
new file mode 100644
index 0000000..d033009
--- /dev/null
+++ b/gateway/managed_contracts.py
@@ -0,0 +1,167 @@
+"""Authenticated command provenance and single-attempt delivery for gateway consumers.
+
+This API does not authorize arbitrary Python plugins or provide an outbox. Callers
+persist unknown outcomes and must not automatically retry them.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import math
+from dataclasses import asdict, dataclass
+from typing import Optional
+
+from gateway.config import Platform
+from gateway.platforms.base import SendResult
+
+
+INTEGRATION_NATIVE_COMMANDS = frozenset({"help", "status", "whoami", "platforms", "version", "start"})
+STRICT_SEND_PLATFORMS = frozenset({"telegram", "wecom"})
+
+
+def strict_send_supported(platform: str) -> bool:
+    """Adapter capability implemented here; not proof that any account is connected."""
+    return isinstance(platform, str) and platform in STRICT_SEND_PLATFORMS
+
+
+@dataclass(frozen=True)
+class TrustedCommandContext:
+    platform: str
+    profile: str
+    transport_profile: str
+    user_id: Optional[str]
+    chat_id: str
+    thread_id: Optional[str]
+    source_message_id: Optional[str]
+    chat_type: str
+
+
+@dataclass(frozen=True)
+class StrictTarget:
+    profile: str
+    platform: str
+    chat_id: str
+    thread_id: Optional[str] = None
+
+
+def integration_only(runner) -> bool:
+    return getattr(getattr(runner, "config", None), "integration_only", False) is True
+
+
+def native_source_message_id(event) -> Optional[str]:
+    """Return transport message identity, excluding adapter bookkeeping fallbacks.
+
+    Adapters must mark generated IDs and non-message request IDs as synthetic.
+    Call before untrusted pre-dispatch hooks; this function does not authorize
+    its caller or turn hook-provided data into authenticated context.
+    """
+    if getattr(event, "message_id_is_synthetic", False) is not False:
+        return None
+    value = event.message_id or getattr(event.source, "message_id", None)
+    if isinstance(value, bool) or not isinstance(value, (str, int)) or not value:
+        return None
+    return str(value)
+
+
+def command_context(runner, source, source_message_id) -> TrustedCommandContext:
+    """Called only after ingress authorization, using the pre-hook source snapshot."""
+    primary = getattr(runner, "_primary_profile_name", None) or runner._active_profile_name()
+    owner = runner._transport_owner(source)
+    transport_profile = (owner[1] or primary) if owner is not None else (source.profile or primary)
+    return TrustedCommandContext(
+        platform=source.platform.value, profile=source.profile or primary,
+        transport_profile=transport_profile, user_id=source.user_id,
+        chat_id=source.chat_id, thread_id=source.thread_id,
+        source_message_id=str(source_message_id) if source_message_id else None,
+        chat_type=source.chat_type,
+    )
+
+
+def strict_result(status: str, error: Optional[str] = None, *, target=None,
+                  message_id=None, receipt_id=None) -> SendResult:
+    """Adapter result: target contains only platform-confirmed chat/thread identifiers."""
+    return SendResult(
+        success=status == "sent", message_id=message_id, error=error,
+        delivery_status=status, delivery_target=target, receipt_id=receipt_id,
+    )
+
+
+def _observe_task(task) -> None:
+    if not task.cancelled():
+        task.exception()
+
+
+async def send_strict(runner, target: StrictTarget, text: str, *, timeout: float = 30.0) -> dict:
+    """Use exactly one currently connected adapter; never connect, redirect or retry.
+
+    ``target`` in the receipt is the actual confirmed target (None if unconfirmed).
+    ``requested_target`` is always the explicit request. WeCom may acknowledge a
+    request without supplying a message ID; its ACK ID is then ``receipt_id``.
+    """
+    requested = asdict(target) if isinstance(target, StrictTarget) else None
+
+    def receipt(status, error=None, *, actual=None, message_id=None, receipt_id=None):
+        return {"status": status, "message_id": message_id, "receipt_id": receipt_id,
+                "requested_target": requested, "target": actual, "error_code": error}
+
+    if not isinstance(target, StrictTarget) or any(
+        not isinstance(value, str) or not value or value != value.strip()
+        for value in (target.profile, target.platform, target.chat_id)
+    ) or (target.thread_id is not None and (
+        not isinstance(target.thread_id, str) or not target.thread_id or target.thread_id != target.thread_id.strip()
+    )):
+        return receipt("not_sent", "invalid_target")
+    if not isinstance(text, str) or not text.strip():
+        return receipt("not_sent", "invalid_text")
+    if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not math.isfinite(timeout) or timeout <= 0:
+        return receipt("not_sent", "invalid_timeout")
+    try:
+        platform = Platform(target.platform)
+    except ValueError:
+        return receipt("not_sent", "unsupported_platform")
+    if not strict_send_supported(target.platform):
+        return receipt("not_sent", "strict_delivery_unsupported")
+    # No ambient active-profile or "default" fallback: a named primary owns its
+    # own adapters, while secondary profiles have explicit maps.
+    primary = getattr(runner, "_primary_profile_name", None)
+    profiles = getattr(runner, "_profile_adapters", None) or {}
+    adapters = (getattr(runner, "adapters", None) or {}) if target.profile == primary else profiles.get(target.profile, {})
+    adapter = adapters.get(platform)
+    if adapter is None or getattr(adapter, "is_connected", False) is not True:
+        return receipt("not_sent", "live_adapter_unavailable")
+    if getattr(adapter, "STRICT_DELIVERY_CAPABLE", False) is not True:
+        return receipt("not_sent", "strict_delivery_unsupported")
+    try:
+        task = asyncio.create_task(adapter.send_strict(target.chat_id, text, thread_id=target.thread_id))
+    except Exception:
+        return receipt("unknown", "adapter_exception")
+    try:
+        done, _ = await asyncio.wait({task}, timeout=timeout)
+        if task not in done:
+            task.cancel()
+            task.add_done_callback(_observe_task)
+            return receipt("unknown", "delivery_timeout")
+        result = task.result()
+    except asyncio.CancelledError:
+        task.cancel()
+        task.add_done_callback(_observe_task)
+        return receipt("unknown", "delivery_cancelled")
+    except Exception:
+        return receipt("unknown", "adapter_exception")
+    if not isinstance(result, SendResult) or result.delivery_status not in {"sent", "not_sent", "unknown"}:
+        return receipt("unknown", "invalid_adapter_receipt")
+    actual = None
+    if isinstance(result.delivery_target, dict):
+        actual = {"profile": target.profile, "platform": target.platform,
+                  "chat_id": result.delivery_target.get("chat_id"),
+                  "thread_id": result.delivery_target.get("thread_id")}
+    if result.continuation_message_ids or (result.delivery_status == "not_sent" and (
+        result.success is not False or result.message_id is not None
+    )) or (result.delivery_status == "sent" and (
+        result.success is not True or actual != requested or result.error is not None
+        or not (result.message_id or result.receipt_id)
+    )):
+        return receipt("unknown", "unconfirmed_delivery", actual=actual,
+                       message_id=result.message_id, receipt_id=result.receipt_id)
+    return receipt(result.delivery_status, result.error, actual=actual,
+                   message_id=result.message_id, receipt_id=result.receipt_id)
