@@ -0,0 +1,50 @@
+"""Single plain-text Bot API request, preserving the explicit Telegram target."""
+
+from __future__ import annotations
+
+import asyncio
+import re
+
+from gateway.managed_contracts import strict_result
+
+
+async def send_strict(adapter, chat_id: str, content: str, *, thread_id=None):
+    # Usernames resolve to another ID; strict callers bind the numeric identity
+    # seen on ingress instead of asking Telegram to choose an account at send time.
+    if not isinstance(chat_id, str) or not re.fullmatch(r"-?[1-9][0-9]*", chat_id):
+        return strict_result("not_sent", "invalid_chat_id")
+    if thread_id is not None and (not isinstance(thread_id, str) or not re.fullmatch(r"[1-9][0-9]*", thread_id)):
+        return strict_result("not_sent", "invalid_thread_id")
+    if not isinstance(content, str) or not content.strip():
+        return strict_result("not_sent", "invalid_text")
+    try:
+        utf16_length = len(content.encode("utf-16-le")) // 2
+    except UnicodeError:
+        return strict_result("not_sent", "invalid_text")
+    if utf16_length > adapter.MAX_MESSAGE_LENGTH:
+        return strict_result("not_sent", "text_too_long")
+    if not adapter.is_connected or not adapter._bot or getattr(adapter, "_send_path_degraded", False):
+        return strict_result("not_sent", "live_adapter_unavailable")
+    kwargs = {"chat_id": int(chat_id), "text": content, "parse_mode": None}
+    if thread_id is not None and thread_id != adapter._GENERAL_TOPIC_THREAD_ID:
+        kwargs["message_thread_id"] = int(thread_id)
+    try:
+        message = await adapter._bot.send_message(**kwargs)
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        # Positive server rejection proves no message was accepted. Network errors
+        # and ACK timeouts are ambiguous; no reconnect, retry or thread downgrade.
+        from telegram.error import BadRequest, Forbidden, RetryAfter
+        if isinstance(exc, (BadRequest, Forbidden, RetryAfter)):
+            return strict_result("not_sent", "platform_rejected")
+        return strict_result("unknown", "transport_exception")
+    actual_chat = getattr(getattr(message, "chat", None), "id", None)
+    actual_thread = adapter._effective_message_thread_id(message)
+    actual = {"chat_id": str(actual_chat) if actual_chat is not None else None,
+              "thread_id": actual_thread}
+    message_id = getattr(message, "message_id", None)
+    if actual != {"chat_id": chat_id, "thread_id": thread_id} or not message_id:
+        return strict_result("unknown", "target_or_receipt_mismatch", target=actual,
+                             message_id=str(message_id) if message_id else None)
+    return strict_result("sent", target=actual, message_id=str(message_id))
