+
+
+@pytest.fixture(autouse=True)
+def no_external_io(monkeypatch, tmp_path):
+    def denied(*args, **kwargs):
+        raise AssertionError("This contract test must not access a network")
+
+    monkeypatch.setattr(socket.socket, "connect", denied)
+    monkeypatch.setattr(socket.socket, "connect_ex", denied)
+    monkeypatch.setattr(socket.socket, "sendto", denied)
+    monkeypatch.setattr(socket, "getaddrinfo", denied)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+
+
+@pytest.fixture
+def command_host(monkeypatch, tmp_path):
+    # Real on-disk plugin discovery and registration; no test-owned command dispatcher.
+    home = tmp_path / "profile"
+    plugin = home / "plugins" / "contract-test"
+    plugin.mkdir(parents=True)
+    (plugin / "plugin.yaml").write_text("name: contract-test\nversion: 0.1.0\n")
+    (plugin / "__init__.py").write_text(
+        "import json\nfrom dataclasses import asdict\n"
+        "def contextual(raw_args, context):\n"
+        "    if raw_args == 'explode': raise ValueError('synthetic failure')\n"
+        "    if raw_args == 'silent-none': return None\n"
+        "    if raw_args == 'silent-empty': return ''\n"
+        "    return json.dumps({'args': raw_args, 'context': asdict(context)})\n"
+        "def register(ctx):\n"
+        "    ctx.register_command('contract-test', contextual, with_context=True)\n"
+        "    ctx.register_command('legacy-test', lambda raw_args: 'legacy:' + raw_args)\n"
+    )
+    (home / "config.yaml").write_text("plugins:\n  enabled: [contract-test]\n")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("TELEGRAM_ALLOWED_USERS", "alice,bob")
+    import hermes_cli.plugins as plugins
+    plugins.discover_plugins(force=True)
+    assert plugins.get_plugin_command_handler("contract-test") is not None
+
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(
+        integration_only=True, unauthorized_dm_behavior="ignore",
+        platforms={Platform.TELEGRAM: PlatformConfig(enabled=True)},
+    )
+    runner._primary_profile_name = "managed"
+    runner._profile_adapters = {}
+    runner.adapters = {}
+    runner._draining = False
+    runner._running_agents = {}
+    runner.hooks = SimpleNamespace(emit=AsyncMock(), emit_collect=AsyncMock(return_value=[]))
+    runner._run_agent = AsyncMock(side_effect=AssertionError("agent must not start"))
+    return runner
+
+
+def event(user="alice", chat="10", text="/contract-test hello", *, internal=False, message_id="m1"):
+    return MessageEvent(
+        text=text, internal=internal, message_id=message_id,
+        source=SessionSource(platform=Platform.TELEGRAM, user_id=user, chat_id=chat,
+                             chat_type="dm", thread_id="7"),
+    )
+
+
+@pytest.mark.asyncio
+async def test_dispatch_uses_frozen_ingress_identity_and_real_authorization(command_host, monkeypatch):
+    runner = command_host
+    real_hook = runner._hm_pre_gateway_dispatch_hook
+
+    def mutating_hook(inbound, source):
+        inbound.source.user_id = "alice"
+        inbound.source.chat_id = "forged-chat"
+        inbound.source.profile = "forged-profile"
+        inbound.message_id = "forged-id"
+        inbound.internal = True
+        return real_hook(inbound, source)
+
+    monkeypatch.setattr(runner, "_hm_pre_gateway_dispatch_hook", mutating_hook)
