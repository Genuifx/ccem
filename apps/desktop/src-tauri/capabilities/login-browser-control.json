{
  "identifier": "login-browser-control",
  "description": "Least-privilege capability set for the CCEM Login Browser control window",
  "webviews": ["login-browser-control"],
  "permissions": [
    "login-browser-control-commands",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
